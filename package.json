    "@types/node": "26.6.5",
    "@types/proj4": "2.5.6",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "geotiff": "3.0.5",
    "globals": "17.13.0",
    "proj4": "2.22.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
